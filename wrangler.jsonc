// GT: GET THIS — Cloudflare Worker (API + static web app + realtime).
//
// Push-to-deploy: connect this GitHub repo in the Cloudflare dashboard
// (Workers & Pages → Create → Import a repository). Every push to main then
// rebuilds and publishes automatically. See docs/DEPLOY.md.
//
// Free plan only: over-limit requests fail with an error instead of being billed.
// The default Worker ("getting-there-with-claude") is the PREVIEW. Production is a
// separate Worker and database, deployed only with --env production.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getting-there-with-claude",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // The Expo web export is served as static assets (free, unmetered).
  // Only /api/* reaches the Worker.
  "assets": {
    "directory": "apps/mobile/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // No database_id: Wrangler finds the database by name, or creates it on the
  // first deploy. Tables are created by the Worker itself on first request.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "getting-there-db",
      "migrations_dir": "apps/api/migrations"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "ARENA", "class_name": "Arena" }]
  },
  // SQLite-backed Durable Objects are the only kind available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Arena"] }],

  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    "GT_ENV": "preview",
    "RAKE_BPS": "500"
  },

  "observability": { "enabled": false },

  "env": {
    // Production: only when Travis decides. npm run deploy:production
    "production": {
      "name": "getting-there-live",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "getting-there-live-db",
          "migrations_dir": "apps/api/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "ARENA", "class_name": "Arena" }]
      },
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "GT_ENV": "production",
        "RAKE_BPS": "500"
      }
    }
  }
}
