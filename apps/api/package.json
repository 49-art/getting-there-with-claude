{
  "name": "@gt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c ../../wrangler.jsonc --local --port 8787",
    "dict": "node --experimental-strip-types ../../scripts/build-dictionary.ts",
    "db:migrate:local": "wrangler d1 migrations apply getting-there-db -c ../../wrangler.jsonc --local",
    "deploy:preview": "wrangler deploy -c ../../wrangler.jsonc",
    "deploy:production": "wrangler deploy -c ../../wrangler.jsonc --env production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gt/engine": "*",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "~6.0.3",
    "wordlist-english": "^1.2.1",
    "wrangler": "^4.157.0"
  }
}
