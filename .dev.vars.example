# Copy to .dev.vars (in the repo root) for local development. Never commit .dev.vars.
# Optional: without GT_SECRET the local Worker generates one, like the preview does.
# GT_SECRET must be 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
# Optional: enables POST /api/admin/plan locally.
ADMIN_TOKEN=replace-with-another-long-random-string
GT_ENV=development
